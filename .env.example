# Intern-S2-Preview API
INTERN_API_BASE_URL=https://chat.intern-ai.org.cn/api
INTERN_API_KEY=your_api_key_here
INTERN_MODEL_NAME=intern-s2-preview

# Optional aliases accepted by config.py
API_BASE_URL=
API_KEY=

# MinerU / Sciverse are used by B's Knowledge Pipeline Worker.
MINERU_API_KEY=
SCIVERSE_API_KEY=

# Harness defaults
EVISURVEY_LANGUAGE=zh
EVISURVEY_MODE=demo
REQUEST_TIMEOUT_SECONDS=60
MAX_LLM_RETRIES=1
TOOL_TIMEOUT_SECONDS=300
TOOL_RESULT_MAX_CHARS=6000

# NLI model (cross-encoder/nli-deberta-v3-base) downloads from HuggingFace on first use.
# If HF is slow/blocked: HF_ENDPOINT=https://hf-mirror.com (read natively by huggingface_hub)
HF_ENDPOINT=
